// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ══════════════════════════════════════════════════════════════════
   The Growth OS data layer — every model the engine writes to.
   ══════════════════════════════════════════════════════════════════ */

/// The agent chat's conversation thread — one per client session.
model Conversation {
  id        String       @id @default(cuid())
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  Message[]
  sites     Site[]
  media     Media[]
  runs      AgentRun[]
}

/// One turn in a conversation.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  meta           String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Long-term memory — the project-knowledge store (scope+key upserts).
model Memory {
  id        String   @id @default(cuid())
  scope     String
  key       String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
}

/// The Growth OS engine's client memory — business facts, preferences
/// and build decisions, upserted by scope+key every run.
model AgentMemory {
  id        String   @id @default(cuid())
  scope     String
  key       String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
}

/// A versioned site build produced by the orchestrator.
model Site {
  id             String       @id @default(cuid())
  name           String
  brief          String?
  html           String
  designSeed     String?
  score          Int?
  checks         String?
  version        Int          @default(1)
  conversationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId, updatedAt])
}

/// Generated media — images, voice tracks and video renders.
model Media {
  id             String       @id @default(cuid())
  kind           String
  prompt         String?
  data           String?
  mimeType       String?
  ref            String?      @unique
  url            String?
  status         String       @default("done")
  conversationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
}

/// One full engine run — its classification, steps and timing.
model AgentRun {
  id             String       @id @default(cuid())
  conversationId String?
  task           String?
  intent         String?
  steps          String?
  toolCalls      Int?
  durationMs     Int?
  success        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Client briefs filed from the lead forms.
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String?
  industry  String?
  budget    String?
  brief     String?
  source    String?
  createdAt DateTime @default(now())
}

/// Analytics events (the Module Playbook's 23-event vocabulary).
model Event {
  id        String   @id @default(cuid())
  name      String
  route     String?
  template  String?
  tier      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}

/// A saved page composition — a module list per page.
model PageComposition {
  id        String   @id @default(cuid())
  name      String
  modules   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
