        "content": "```html\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Growth OS</title>\n<script src=\"https://cdn.jsdelivr.net/npm/react@18.0.0/umd/react.development.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/react-dom@18.0.0/umd/react-dom.development.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/@babel/standalone/babel.js\"></script>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  body { font-family: 'Inter', sans-serif; }\n  .mono { font-family: 'JetBrains Mono', monospace; }\n</style>\n</head>\n<body class=\"bg-[#f4f4f0]\">\n<div id=\"root\"></div>\n<script type=\"text/babel\">\nconst { useState } = React;\n\nconst navItems = [\"Builder\",\"AI Studio\",\"Motion\",\"Library\",\"Catalogue\",\"Forge\",\"Playbook\"];\n\nfunction Header({active, setActive}) {\n  return (\n    <header className=\"fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur border-b border-gray-200/70\">\n      <div className=\"max-w-6xl mx-auto px-6 h-14 flex items-center justify-between\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-7 h-7 rounded-md bg-emerald-600 flex items-center justify-center text-white font-bold text-sm\">G</div>\n          <span className=\"font-bold text-gray-900\">Growth OS</span>\n        </div>\n        <nav className=\"hidden md:flex items-center gap-1\">\n          {navItems.map(item => (\n            <button key={item} onClick={()=>setActive(item)}\n              className={`px-3 py-1.5 text-sm rounded-full transition-colors duration-150 ${active===item ? \"bg-emerald-50 text-emerald-700 font-medium\" : \"text-gray-600 hover:text-gray-900 hover:bg-gray-100\"}`}>\n              {item}\n            </button>\n          ))}\n        </nav>\n        <div className=\"flex items-center gap-2 border border-gray-200 rounded-full px-3 py-1.5 text-sm text-gray-400 bg-white\">\n          <i className=\"fas fa-search text-xs\"></i>\n          <span>Search</span>\n          <span className=\"mono text-[10px] border border-gray-200 rounded px-1\">⌘K</span>\n        </div>\n      </div>\n    </header>\n  );\n}\n\nfunction Hero({onBuild}) {\n  return (\n    <section className=\"pt-28 pb-16 max-w-6xl mx-auto px-6\">\n      <p className=\"mono text-xs text-emerald-600 tracking-widest mb-4\">01 — GROWTH OS</p>\n      <h1 className=\"text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight max-w-3xl leading-tight\">\n        The operating system for growing businesses\n      </h1>\n      <p className=\"mt-5 text-gray-600 text-lg max-w-2xl\">\n        Launch a real, working website in minutes — booking flows, listings, portals and more,\n        built on a 344-module playbook.\n      </p>\n      <div className=\"mt-8 flex items-center gap-3\">\n        <button onClick={onBuild} className=\"bg-emerald-600 hover:bg-emerald-700 transition-colors duration-150 text-white font-semibold px-6 py-3 rounded-full flex items-center gap-2 shadow\">\n          <i className=\"fas fa-magic\"></i> Build a website\n        </button>\n        <button className=\"border border-gray-300 hover:bg-white transition-colors duration-150 text-gray-700 font-medium px-6 py-3 rounded-full\">\n          Browse the library\n        </button>\n      </div>\n    </section>\n  );\n}\n\nfunction ShowcaseCard({site}) {\n  return (\n    <div className=\"bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col\">\n      <div className=\"h-64 relative\">\n        <div className={`absolute inset-0 ${site.bg}`}></div>\n        <div className=\"absolute inset-0 flex flex-col\">\n          <div className=\"flex items-center gap-2 px-4 py-3\">\n            <div className={`w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-bold ${site.badge}`}>{site.initials}</div>\n            <div className=\"leading-tight\">\n              <div className={`text-xs font-semibold ${site.dark ? \"text-white\" : \"text-gray-900\"}`}>{site.name}</div>\n              <div className={`mono text-[9px] ${site.dark ? \"text-gray-300\" : \"text-gray-500\"}`}>{site.tagline}</div>\n            </div>\n          </div>\n          <div className=\"flex-1 px-4 flex items-center justify-center\">\n            {site.emoji ? <span className=\"text-5xl\">{site.emoji}</span> : null}\n            {site.chart ? (\n              <div className=\"flex items-end gap-1 h-20\">\n                {[3,5,4,7,6,9,8,11,10,14].map((h,i)=>(\n                  <div key={i} className=\"w-2 bg-white/60 rounded-t\" style={{height: h*5}}></div>\n                ))}\n              </div>\n            ) : null}\n            {site.houses ? (\n              <div className=\"flex gap-2\">\n                {[0,1,2,3].map(i=>(\n                  <div key={i} className=\"w-10 h-12 border-2 border-white/60 rounded-t-md relative\">\n                    <div className=\"absolute -top-1 left-1 right-1 h-2 bg-white/60\" style={{clipPath:\"polygon(50% 0,100% 100%,0 100%)\"}}></div>\n                  </div>\n                ))}\n              </div>\n            ) : null}\n          </div>\n          <div className={`mx-4 mb-3 rounded-lg px-3 py-2 text-xs font-medium ${site.dark ? \"bg-white/10 text-white\" : \"bg-black text-white\"} flex items-center justify-between`}>\n            <span>{site.ctaLabel}</span><span>→</span>\n          </div>\n        </div>\n      </div>\n      <div className=\"p-5 flex-1 flex flex-col\">\n        <div className=\"flex items-start justify-between\">\n          <h3 className=\"font-bold text-gray-900\">{site.name}</h3>\n          <span className=\"mono text-[10px] text-gray-400 tracking-widest\">{site.tier.toUpperCase()}</span>\n        </div>\n        <p className=\"mono text-xs text-gray-500 mt-1\">{site.category}</p>\n        <div className=\"mt-auto pt-4 flex items-center gap-5\">\n          <a href=\"#\" className=\"text-emerald-700 font-semibold text-sm hover:underline transition-colors duration-150\">Open in the library <span className=\"ml-1\">→</span></a>\n          <a href=\"#\" className=\"text-gray-600 text-sm hover:text-gray-900 transition-colors duration-150\">Full page <i className=\"fas fa-external-link-alt text-[10px]\"></i></a>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nconst sites = [\n  { name:\"Nightflow 24/7 Plumbing\", tagline:\"EMERGENCY PLUMBING\", initials:\"NF\", badge:\"bg-amber-400 text-gray-900\", bg:\"bg-[#fdf6e8]\", emoji:\"🔧\", dark:false, ctaLabel:\"Book an engineer now\", tier:\"flagship\", category:\"Home Services · Flagship tier\" },\n  { name:\"Rowan & Vale\", tagline:\"ESTATE AGENCY · CHORLTON\", initials:\"RV\", badge:\"bg-[#f8f4ec] text-amber-800\", bg:\"bg-[#f8f4ec]\", emoji:\"🏘️\", dark:false, ctaLabel:\"8 homes on our books today\", tier:\"growth\", category:\"Property & Real Estate · Growth tier\" },\n  { name:\"Northbank Residences\", tagline:\"Residences · Purchase Portal Progress\", initials:\"NR\", badge:\"bg-emerald-900 text-white\", bg:\"bg-gray-900\", chart:true, houses:true, dark:true, ctaLabel:\"Register interest\", tier:\"flagship\", category:\"Property & Real Estate · Flagship tier\" },\n];\n\nfunction ModulePlaybook() {\n  const chips = [\"Navigation & headers\",\"Booking flows\",\"Listings & search\",\"Quote calculators\",\"Client portals\",\"Galleries\"];\n  return (\n    <section className=\"max-w-6xl mx-auto px-6 py-16\">\n      <div className=\"bg-white rounded-2xl border border-gray-200 shadow-sm p-8 md:p-10\">\n        <p className=\"mono text-xs text-emerald-600 tracking-widest mb-4\">04 — THE BUILD STANDARD</p>\n        <div className=\"grid md:grid-cols-2 gap-10 items-start\">\n          <div>\n            <h2 className=\"text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight\">The Module Playbook</h2>\n            <p className=\"mt-4 text-gray-600\">344 modules · 20 sections · every module with real content rules, a11y notes and reference code — tiered Starter → Flagship.</p>\n            <div className=\"mt-6 flex flex-wrap gap-2\">\n              {chips.map(c=>(\n                <span key={c} className=\"border border-gray-200 rounded-full px-3 py-1.5 text-sm text-gray-600 bg-gray-50\">{c}</span>\n              ))}\n            </div>\n            <button className=\"mt-6 bg-emerald-600 hover:bg-emerald-700 transition-colors duration-150 text-white font-semibold px-5 py-3 rounded-full text-sm\">\n              Open the playbook <span>›</span>\n            </button>\n          </div>\n          <div>\n            <p className=\"mono text-xs text-gray-500 tracking-widest mb-4\">MODULES PER TIER</p>\n            <div className=\"flex h-3 rounded-full overflow-hidden\">\n              <div className=\"bg-emerald-200\" style={{width:\"15%\"}}></div>\n              <div className=\"bg-emerald-500\" style={{width:\"26%\"}}></div>\n              <div className=\"bg-emerald-700\" style={{width:\"11%\"}}></div>\n              <div className=\"bg-emerald-400\" style={{width:\"40%\"}}></div>\n              <div className=\"bg-emerald-800\" style={{width:\"8%\"}}></div>\n            </div>\n            <div className=\"mt-5 grid grid-cols-5 gap-2\">\n              {[[\"Starter\",\"50\",\"bg-emerald-200\"],[\"Growth\",\"88\",\"bg-emerald-500\"],[\"Scale\",\"39\",\"bg-emerald-700\"],[\"Business\",\"136\",\"bg-emerald-400\"],[\"Flagship\",\"31\",\"bg-emerald-800\"]].map(([label,n,dot])=>(\n                <div key={label}>\n                  <div className=\"flex items-center gap-1.5 text-sm text-gray-600\"><span className={`w-2 h-2 rounded-full ${dot}`}></span>{label}</div>\n                  <div className=\"text-3xl font-extrabold text-gray-900 mt-1\">{n}</div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nfunction SystemMap() {\n  const entries = [\n    [\"Builder\",\"Compose pages from library modules\"],[\"AI Studio\",\"Generate copy, imagery and layouts\"],\n    [\"Motion\",\"Transitions and micro-interactions\"],[\"Library\",\"344 ready-to-ship modules\"],\n    [\"Catalogue\",\"Browse sites by industry and tier\"],[\"Forge\",\"Custom module development\"],\n    [\"Playbook\",\"Content rules and reference code\"],\n  ];\n  return (\n    <section className=\"max-w-6xl mx-auto px-6 pb-16\">\n      <p className=\"mono text-xs text-emerald-600 tracking-widest mb-4\">03 — THE SYSTEM MAP</p>\n      <h2 className=\"text-3xl font-extrabold text-gray-900 tracking-tight mb-8\">How everything connects</h2>\n      <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {entries.map(([name,desc])=>(\n          <div key={name} className=\"bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md transition-shadow duration-200\">\n            <div className=\"flex items-center gap-2\">\n              {name===\"Builder\" && <i className=\"fas fa-hammer text-emerald-600 text-sm\"></i>}\n              <h3 className=\"font-bold text-gray-900\">{name}</h3>\n            </div>\n            <p className=\"text-sm text-gray-500 mt-2\">{desc}</p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nfunction App() {\n  const [active, setActive] = useState(\"Builder\");\n  const [toast, setToast] = useState(false);\n  const build = () => { setToast(true); setTimeout(()=>setToast(false), 2500); };\n  return (\n    <div className=\"min-h-screen flex flex-col\">\n      <Header active={active} setActive={setActive} />\n      <main className=\"flex-1 pt-14\">\n        <Hero onBuild={build} />\n        <section className=\"max-w-6xl mx-auto px-6 pb-8\">\n          <div className=\"grid md:grid-cols-3 gap-6\">\n            {sites.map(s=><ShowcaseCard key={s.name} site={s} />)}\n          </div>\n        </section>\n        <SystemMap />\n        <ModulePlaybook />\n      </main>\n      <footer className=\"sticky bottom-0 bg-white/90 backdrop-blur border-t border-gray-200 py-3\">\n        <div className=\"max-w-6xl mx-auto px-6 flex items-center justify-between text-sm text-gray-500\">\n          <span className=\"font-semibold text-gray-700\">Growth OS</span>\n          <span className=\"mono text-xs\">⌘ ⌘K</span>\n        </div>\n      </footer>\n      {toast && (\n        <div className=\"fixed bottom-16 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-5 py-3 rounded-full shadow-lg text-sm\">\n          <i className=\"fas fa-magic mr-2 text-emerald-400\"></i>Builder started — pick a template to begin\n        </div>\n      )}\n    </div>\n  );\n}\n\nReactDOM.createRoot(document.getElementById('root')).render(<App />);\n</script>\n</body>\n</html>\n```",
