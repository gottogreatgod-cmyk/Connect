r gap-1.5 text-sm font-semibold text-gray-800 hover:text-emerald-700 transition-colors duration-150\">\n          <i className=\"fas fa-wand-magic-sparkles fas fa-magic text-emerald-600\"></i>\n          AI Studio\n        </a>\n      </div>\n    </header>\n  );\n}\n\nfunction StepRail({ current }) {\n  return (\n    <div className=\"px-3 pt-4 pb-3 border-b border-gray-100\">\n      <div className=\"flex gap-2 overflow-x-auto no-scrollbar\">\n        {steps.map(s => (\n          <div key={s.n}\n            className={\"shrink-0 flex items-center gap-2 px-3 py-2 rounded-full text-sm transition-colors duration-150 \" +\n              (s.n === current\n                ? \"bg-white border-2 border-emerald-500 font-bold text-gray-900 shadow-sm\"\n                : \"bg-emerald-50 text-emerald-800 border border-emerald-100\")}>\n            <span className={\"w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold \" +\n              (s.n === current ? \"bg-emerald-600 text-white\" : \"bg-white text-emerald-700 border border-emerald-200\")}>\n              {s.n}\n            </span>\n            <span className=\"hidden xs:inline\">{s.label}</span>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction RecommendedCard() {\n  return (\n    <div className=\"mx-4 mt-5 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 flex items-start gap-3\">\n      <div className=\"w-8 h-8 shrink-0 rounded-full bg-white border border-emerald-200 flex items-center justify-center text-emerald-600 mt-0.5\">\n        <i className=\"far fa-lightbulb text-sm\"></i>\n      </div>\n      <div className=\"flex-1\">\n        <p className=\"font-bold text-gray-900 leading-snug\">Recommended next — Write your launch copy.</p>\n        <p className=\"text-sm text-gray-600 mt-0.5\">AI copy for your business, seeded from your starting point.</p>\n      </div>\n      <button className=\"shrink-0 self-center inline-flex items-center gap-1 text-sm font-bold tex